{
  "expo": {
    "name": "AnimalTalk",
    "slug": "animaltalk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/AnimalTalk_app_icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/AnimalTalk_app_icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.xMomTalk"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/AnimalTalk_app_icon.png",
        "backgroundColor": "#ffffff",
        "softwareKeyboardLayoutMode": "resize"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.xMomTalk"
    },
    "web": {
      "favicon": "./assets/AnimalTalk_app_icon.png"
    },
    "plugins": [
      "expo-video"
    ]
  }
}
