{
  "expo": {
    "name": "MomTalk",
    "slug": "momtalk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/MomTalk_app_icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/MomTalk_app_icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/MomTalk_app_icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.xMomTalk"
    },
    "web": {
      "favicon": "./assets/MomTalk_app_icon.png"
    },
    "plugins": [
      "expo-video"
    ]
  }
}
